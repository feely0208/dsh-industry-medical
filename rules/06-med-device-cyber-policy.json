{
  "id": "MED-DEVICE-CYBER-POLICY",
  "title": "找不到覆盖医疗设备全生命周期的网络安全管理制度",
  "severity": "medium",
  "source": "《医疗卫生机构网络安全管理办法》（国卫规划发〔2022〕29号）第十四条 —— 建立健全医疗设备招标采购、安装调试、运行使用、维护维修、报废处置等相关网络安全管理制度",
  "advice": "项目里出现了 DICOM/HL7/PACS/监护/输液泵等医疗设备接入痕迹，但 docs 与制度目录里找不到一份同时写明「医疗设备」与「网络安全」、并覆盖采购、安装、运行、维护、报废中至少四个环节的制度。请补一份设备全生命周期网络安全制度；若制度在医院其他体系文件里，请在仓库中留存文件名与章节索引，便于测评时调取。",
  "check": {
    "type": "files-lack",
    "pattern": "(?=[\\s\\S]*医疗设备)(?=[\\s\\S]*网络安全)(?:(?=[\\s\\S]*(?:安装调试|安装))(?=[\\s\\S]*(?:运行使用|运行))(?=[\\s\\S]*(?:维护维修|维护|维修))(?=[\\s\\S]*(?:报废处置|报废))|(?=[\\s\\S]*(?:招标采购|采购))(?=[\\s\\S]*(?:运行使用|运行))(?=[\\s\\S]*(?:维护维修|维护|维修))(?=[\\s\\S]*(?:报废处置|报废))|(?=[\\s\\S]*(?:招标采购|采购))(?=[\\s\\S]*(?:安装调试|安装))(?=[\\s\\S]*(?:维护维修|维护|维修))(?=[\\s\\S]*(?:报废处置|报废))|(?=[\\s\\S]*(?:招标采购|采购))(?=[\\s\\S]*(?:安装调试|安装))(?=[\\s\\S]*(?:运行使用|运行))(?=[\\s\\S]*(?:报废处置|报废))|(?=[\\s\\S]*(?:招标采购|采购))(?=[\\s\\S]*(?:安装调试|安装))(?=[\\s\\S]*(?:运行使用|运行))(?=[\\s\\S]*(?:维护维修|维护|维修)))",
    "flags": "is",
    "paths": [
      "docs/**",
      "**/制度/**",
      "**/*制度*",
      "**/*管理办法*"
    ],
    "when": "DICOM|HL7|PACS|监护|输液泵",
    "evidence": "docs 与制度目录里没有覆盖医疗设备全生命周期（≥4 个环节）的网络安全制度"
  }
}
